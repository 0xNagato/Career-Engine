# Where the digest goes: channel (default whatsapp) and target (a number in international format)
NOTIFY_CHANNEL="whatsapp"
NOTIFY_TARGET="+00000000000"
# OpenClaw agent whose model and credentials score job posts (optional, default: main)
OPENCLAW_AGENT="main"
